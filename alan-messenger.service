[Unit]
Description=Alan WhatsApp and Telegram messenger

[Service]
Type=simple
User=alan-messenger
Group=alan-ops
Environment=HOME=/var/lib/alan-messenger
EnvironmentFile=/etc/alan/messenger.env
WorkingDirectory=/var/lib/alan-messenger
UMask=0002
ExecStart=/usr/bin/messenger 8081
Restart=on-failure

[Install]
WantedBy=multi-user.target
